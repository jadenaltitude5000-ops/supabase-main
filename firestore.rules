

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if true; // Allow public read of user profiles
      allow list: if false; // Deny listing of all users
      allow create: if request.auth.uid == userId;
      allow update, delete: if isOwner(userId);

      // User-specific subcollections remain private
      match /jobs/{jobId} {
        allow read, write: if isOwner(userId);
      }
      match /freelancerProfile/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /businessProfile/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
      match /feed/{postId} {
        allow read, write: if isOwner(userId);
      }
      match /dailyProductivityData/{reportId} {
        allow read, write: if isOwner(userId);
      }
      match /weeklyProductivityData/{reportId} {
        allow read, write: if isOwner(userId);
      }
      match /monthlyProductivityData/{reportId} {
        allow read, write: if isOwner(userId);
      }
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }
      match /paymentMethods/{methodId} {
        allow read, write: if isOwner(userId);
      }
      match /referrals/{referralId} {
        allow read, write: if isOwner(userId);
      }
      match /campaigns/{campaignId} {
        allow read, write: if isOwner(userId);
      }
      match /contracts/{contractId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /colleagues/{colleagueId} {
        allow read, write: if isOwner(userId);
      }
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }
      match /enrollments/{courseId} {
        allow read, write: if isOwner(userId);
      }
       match /following/{followingId} {
        allow read, list: if true;
        allow create, delete: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow get, list: if true;
        allow write: if false;
      }
    }

    match /posts/{postId} {
      allow get, list: if true; // Allow public read of posts
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if resource.data.userId == request.auth.uid;

      match /replies/{replyId} {
        allow get, list: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if resource.data.userId == request.auth.uid;
      }
    }

    match /votes/{voteId} {
      allow get, list: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && voteId == request.resource.data.postId + '_' + request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    function isParticipant(meetingId) {
      return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.participantIds;
    }

    match /meetings/{meetingId} {
      allow get: if isParticipant(meetingId);
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid;

      match /agenda/{agendaItemId} {
          allow read, write: if isParticipant(meetingId);
      }
      match /minutes/{minuteId} {
          allow read, write: if isParticipant(meetingId);
      }
      match /tasks/{taskId} {
          allow read, write: if isParticipant(meetingId);
      }
       match /calls/{callId} {
          allow read, write: if isParticipant(meetingId);
          match /iceCandidates/{candidateId} {
            allow read, write: if isParticipant(meetingId);
          }
      }
    }

    match /dailyProductivityData/{dataId} { allow get, list: if true; allow write: if false; }
    match /weeklyProductivityData/{dataId} { allow get, list: if true; allow write: if false; }
    match /monthlyProductivityData/{dataId} { allow get, list: if true; allow write: if false; }
    match /dailyProfileEngagementData/{dataId} { allow get, list: if true; allow write: if false; }
    match /weeklyProfileEngagementData/{dataId} { allow get, list: if true; allow write: if false; }
    match /monthlyProfileEngagementData/{dataId} { allow get, list: if true; allow write: if false; }
    match /plans/{planId} { allow get, list: if true; allow write: if false; }

    function isContractParty(contractId) {
      return request.auth != null && exists(/databases/$(database)/documents/contracts/$(contractId)/parties/$(request.auth.uid));
    }
    function isContractOwner(contractId) {
      return request.auth != null && get(/databases/$(database)/documents/contracts/$(contractId)).data.ownerId == request.auth.uid;
    }

    match /contracts/{contractId} {
      allow get: if isContractParty(contractId);
      allow list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)/contracts/$(contractId)).data.role != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isContractOwner(contractId);

      match /parties/{partyId} {
        allow get: if isContractParty(contractId);
        allow list, create, update, delete: if isContractOwner(contractId);
      }
      match /versions/{versionId} {
        allow get: if isContractParty(contractId);
        allow list, create, update, delete: if isContractOwner(contractId);
      }
    }

    function isProjectCreator(projectId) {
      return request.auth != null && get(/databases/$(database)/documents/projects/$(projectId)).data.creatorId == request.auth.uid;
    }
    function isProjectMember(projectId) {
      return request.auth != null && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    match /projects/{projectId} {
      allow get: if isProjectMember(projectId);
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isProjectCreator(projectId);

      match /members/{memberId} {
        allow get, list: if isProjectMember(projectId);
        allow create, delete: if isProjectCreator(projectId);
      }
      match /messages/{messageId} {
        allow read, write: if isProjectMember(projectId);
      }
      match /invitations/{invitationId} {
        allow read, write: if isProjectCreator(projectId);
      }
    }

    match /salesInquiries/{inquiryId} {
      allow create: if true;
      allow read, list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; // Admin only
    }

    match /instructorApplications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, list: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; // Admin only
    }

    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isInstructor == true;
      allow update: if resource.data.instructorId == request.auth.uid;

      match /modules/{moduleId} {
        allow read, list: if true;
        allow write: if get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;

        match /lessons/{lessonId} {
          allow read, list: if true;
          allow write: if get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
        }
      }
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if request.auth != null;
        allow update, delete: if resource.data.userId == request.auth.uid;
      }
    }
    
    match /marketbase/{collection}/{itemId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplified, should check ownership in a real app
    }
  }
}
