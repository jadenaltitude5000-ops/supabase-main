    "/users/{userId}/dailyProductivityData/{reportId}": { "schema": { "$ref": "#/entities/AgencyMetricReport" }, "description": "User's submitted daily agency metrics." },
    "/users/{userId}/weeklyProductivityData/{reportId}": { "schema": { "$ref": "#/entities/AgencyMetricReport" }, "description": "User's submitted weekly agency metrics." },
    "/users/{userId}/monthlyProductivityData/{reportId}": { "schema": { "$ref": "#/entities/AgencyMetricReport" }, "description": "User's submitted monthly agency metrics." },
    "/dailyProductivityData/{dataId}": { "schema": { "$ref": "#/entities/DailyProductivityData" }, "description": "Daily productivity metrics." },
    "/weeklyProductivityData/{dataId}": { "schema": { "$ref": "#/entities/WeeklyProductivityData" }, "description": "Weekly productivity metrics." },
    "/monthlyProductivityData/{dataId}": { "schema": { "$ref": "#/entities/MonthlyProductivityData" }, "description": "Monthly productivity metrics." },
    "/dailyProfileEngagementData/{dataId}": { "schema": { "$ref": "#/entities/DailyProfileEngagementData" }, "description": "Daily profile engagement metrics." },
    "/weeklyProfileEngagementData/{dataId}": { "schema": { "$ref": "#/entities/WeeklyProfileEngagementData" }, "description": "Weekly profile engagement metrics." },
    "/monthlyProfileEngagementData/{dataId}": { "schema": { "$ref": "#/entities/MonthlyProfileEngagementData" }, "description": "Monthly profile engagement metrics." },
    "/users/{userId}/invoices/{invoiceId}": { "schema": { "$ref": "#/entities/Invoice" }, "description": "User's billing invoices." },
    "/users/{userId}/paymentMethods/{methodId}": { "schema": { "$ref": "#/entities/PaymentMethod" }, "description": "User's saved payment methods." },
    "/users/{userId}/referrals/{referralId}": { "schema": { "$ref": "#/entities/Referral" }, "description": "User's referral history." },
    "/plans/{planId}": {
      "schema": { "$ref": "#/entities/Plan" },
