                "timestamp": { "type": "string", "format": "date-time" }
            }
        },
        "description": "Tracks which user has liked which post. The document ID should be a composite key like `${postId}_${userId}`."
    },
    "/users/{userId}/following/{followingId}": {
      "schema": { "$ref": "#/entities/Follow" },
